{
  "name": "dohdec",
  "version": "9.0.1",
  "description": "DNS over HTTPS and DNS over TLS",
  "main": "./lib/index.js",
  "types": "types/",
  "type": "module",
  "scripts": {
    "docs": "typedoc",
    "test": "ava",
    "types": "tsc",
    "check": "npm pack --dry-run",
    "version": "package-extract -so lib/pkg.js name version && git add lib/pkg.js"
  },
  "keywords": [
    "doh",
    "dns-over-https",
    "dns-over-tls",
    "dns",
    "dnssec",
    "rfc7858",
    "rfc8484"
  ],
